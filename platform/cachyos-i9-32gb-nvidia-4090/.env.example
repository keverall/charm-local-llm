OLLAMA_BIN="ollama"
OLLAMA_HOST="[::]:11434"
OLLAMA_PORT="11434"
OLLAMA_NUM_PARALLEL="4"          # Single RTX 4090: 4 parallel slots keep context buffers within 24GB VRAM
# DO NOT USE 24 OR TOO MANY PARALLEL SLOTS, OR YOU WILL RUN OUT OF VRAM AND CRASH YOUR OS ITS A NIGHTMARE DO NOT DO IT!!!
OLLAMA_MAX_LOADED_MODELS="1"     # One large model resident at a time; Ollama evicts the other before loading (24GB can't hold two big models)
OLLAMA_KV_CACHE_TYPE="q4_0"
OLLAMA_GPU_LAYERS="50"           # Full offload to the single RTX 4090
DEFAULT_MODELS="qwen3-coder:30b-gpu,nomic-embed-text:latest,gemma4-26b-devops,devstral-small-2-gpu,deepseek-r1:32b-gpu"
DEVOPS_MODEL="qwen3-coder:30b-gpu"
QUICK_MODEL="devstral-small-2-gpu"
OLLAMA_MODELS="/home/ollama/models"
QDRANT_PORT="6333"
QDRANT_GRPC_PORT="6334"

