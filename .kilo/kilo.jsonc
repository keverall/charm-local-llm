{
  "$schema": "kilo-config-schema.json",
  "indexing": {
    "dimension": 768,
    "enabled": true,
    "model": "nomic-embed-text",
    "ollama": {
      "baseUrl": "http://localhost:11434/"
    },
    "provider": "ollama",
    "qdrant": {
      "url": "http://localhost:6333/"
    },
    "vectorStore": "qdrant"
  },
  "mcp": {
    "duckduckgo-search": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-duckduckgo"
      ],
      "type": "local"
    }
  }
}